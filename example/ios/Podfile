ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => "static"
end

target 'MixpanelReactNativeSessionReplayExample' do
  config = use_native_modules!

  # The Session Replay SDK version this package pins carries wireframe support and is not
  # published yet, so it is consumed from the local working copy. Drop this line once the
  # version in the podspec is on CocoaPods.
  pod 'MixpanelSessionReplay', :path => '../../../mixpanel-ios-session-replay-package'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )


  # Run Codegen during development for the example app.
  pre_install do |installer|
    system("cd ../../ && npx bob build --target codegen")
  end

  # Hosted by the app above, so it needs only header/framework search paths — the pods
  # themselves are already linked into the host. Goldens have to run inside a real app because
  # the wireframe walk needs a *mounted* React Native surface.
  target 'WireframeGoldenTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Build `fmt` as C++17. React Native 0.79 pins fmt 11.0.2, whose `consteval` paths do not
    # compile under Xcode 26's clang; fmt disables them itself below C++20. Affects any RN 0.79
    # iOS build on that toolchain, nothing to do with this package. Remove once RN ships a
    # newer fmt.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end
end
