{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "*.podspec",
    "ios/Package.swift",
    "ios/Sources/**",
    "android/build.gradle",
    "android/gradle.properties",
    "android/src/**",
    "src/**"
  ],
  "pipeline": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "src/**",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "package.json",
        "src/**",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**"
      ],
      "outputs": []
    }
  }
}
